# Copy this file to .env. Never place real credentials in this tracked template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PROVIDER_TIMEOUT_SECONDS=30
MAX_IMAGE_BYTES=6291456
MAX_IMAGE_PIXELS=20000000

# Local development origins. Use exact production origins when deploying.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5604,http://127.0.0.1:5604,https://localhost,capacitor://localhost
ENVIRONMENT=development

# Optional restaurant providers.
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=
FINDER_RADIUS_METERS=6000
HTTP_TIMEOUT_SECONDS=7

# Local bounded caches.
CACHE_TTL_DAYS=30
CACHE_MAX_ENTRIES=500

# Backend listener.
HOST=127.0.0.1
PORT=8000
